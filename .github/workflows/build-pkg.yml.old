name: Build and Release ROI Agent PKG

on:
  push:
    tags:
      - 'v*.*.*'
  workflow_dispatch:
    inputs:
      version:
        description: 'Version to release (e.g., v1.0.4)'
        required: false
        default: 'latest'

jobs:
  build-pkg:
    runs-on: macos-latest
    
    permissions:
      contents: read
      id-token: write
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Set up Go
        uses: actions/setup-go@v4
        with:
          go-version: '1.21'
      
      - name: Extract version
        id: version
        run: |
          if [[ $GITHUB_REF == refs/tags/* ]]; then
            VERSION=${GITHUB_REF#refs/tags/}
          elif [[ "${{ github.event.inputs.version }}" != "" ]]; then
            VERSION="${{ github.event.inputs.version }}"
          else
            VERSION="latest"
          fi
          # Remove 'v' prefix if present
          VERSION=${VERSION#v}
          echo "version=${VERSION}" >> $GITHUB_OUTPUT
          echo "Building version: ${VERSION}"
      
      - name: Install dependencies
        run: |
          cd agent && go mod download
          cd ../data-sender && go mod download
      
      - name: Build PKG (ARM64)
        run: |
          chmod +x scripts/build_pkg.sh
          ./scripts/build_pkg.sh ${{ steps.version.outputs.version }} arm64
      
      - name: Build PKG (x64)
        run: |
          ./scripts/build_pkg.sh ${{ steps.version.outputs.version }} x64
      
      - name: Authenticate to Google Cloud
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ secrets.GCP_WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ${{ secrets.GCP_SA_EMAIL }}
      
      - name: Set up Cloud SDK
        uses: google-github-actions/setup-gcloud@v2
      
      - name: Upload to Cloud Storage
        run: |
          VERSION="${{ steps.version.outputs.version }}"
          BUCKET="gs://roi-agent-releases"
          BUILD_DIR="build/pkg"
          
          echo "Uploading PKG files to Cloud Storage..."
          
          # ARM64 PKG
          if [ -f "$BUILD_DIR/ROI-Agent-macOS-arm64-${VERSION}.pkg" ]; then
            gsutil -h "Cache-Control:no-cache" cp "$BUILD_DIR/ROI-Agent-macOS-arm64-${VERSION}.pkg" \
              "${BUCKET}/latest/macos/"
            gsutil -h "Cache-Control:no-cache" cp "$BUILD_DIR/ROI-Agent-macOS-arm64-${VERSION}.pkg.sha256" \
              "${BUCKET}/latest/macos/"
            echo "✅ ARM64 PKG uploaded"
          fi
          
          # x64 PKG
          if [ -f "$BUILD_DIR/ROI-Agent-macOS-x64-${VERSION}.pkg" ]; then
            gsutil -h "Cache-Control:no-cache" cp "$BUILD_DIR/ROI-Agent-macOS-x64-${VERSION}.pkg" \
              "${BUCKET}/latest/macos/"
            gsutil -h "Cache-Control:no-cache" cp "$BUILD_DIR/ROI-Agent-macOS-x64-${VERSION}.pkg.sha256" \
              "${BUCKET}/latest/macos/"
            echo "✅ x64 PKG uploaded"
          fi
          
          # Version info
          cat > version.json << EOF
          {
            "version": "${VERSION}",
            "release_date": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
            "format": "PKG",
            "platforms": {
              "macos": {
                "arm64": {
                  "file": "ROI-Agent-macOS-arm64-${VERSION}.pkg",
                  "sha256_file": "ROI-Agent-macOS-arm64-${VERSION}.pkg.sha256"
                },
                "x64": {
                  "file": "ROI-Agent-macOS-x64-${VERSION}.pkg",
                  "sha256_file": "ROI-Agent-macOS-x64-${VERSION}.pkg.sha256"
                }
              }
            }
          }
          EOF
          
          gsutil -h "Cache-Control:no-cache" cp version.json "${BUCKET}/latest/"
          
          echo "✅ All files uploaded"
      
      - name: Verify upload
        run: |
          VERSION="${{ steps.version.outputs.version }}"
          BUCKET="gs://roi-agent-releases"
          
          echo "Verifying uploaded files..."
          gsutil ls -lh "${BUCKET}/latest/macos/"
          
          echo ""
          echo "✅ Upload verified"
      
      - name: Build Summary
        run: |
          VERSION="${{ steps.version.outputs.version }}"
          
          echo "========================================" 
          echo "✅ ROI Agent PKG Build Complete!"
          echo "========================================"
          echo ""
          echo "Version: ${VERSION}"
          echo "Format: PKG (macOS Installer)"
          echo ""
          echo "Built packages:"
          ls -lh build/pkg/*.pkg
          echo ""
          echo "SHA256 checksums:"
          cat build/pkg/*.sha256
          echo ""
          echo "🎉 Ready for distribution"
